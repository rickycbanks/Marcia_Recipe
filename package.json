    "@types/node": "^22",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/tar-stream": "3.1.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
