    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cli:create-owner": "tsx scripts/create-owner.ts",
    "cli:reset-password": "tsx scripts/reset-password.ts",
    "cli:backup": "tsx scripts/backup.ts",
    "cli:restore": "tsx scripts/restore.ts",
    "cli:migrate": "tsx scripts/migrate.ts",
    "cli:rebuild-indexes": "tsx scripts/rebuild-indexes.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@serwist/next": "9.5.12",
    "archiver": "^8.0.0",
    "cheerio": "1.2.0",
    "fuse.js": "7.5.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "serwist": "9.5.12",
    "sharp": "0.35.3",
    "tar-stream": "3.2.0",
