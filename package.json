{
  "name": "marcia-recipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marcia Recipe — a self-hosted, flat-file personal recipe binder",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
