NODE_ENV=development
DATA_ROOT=./data
AUTH_SECRET=development-secret-replace-in-production
SETUP_TOKEN=local-development-setup-token
APP_ORIGIN=http://localhost:3000
AUTH_URL=http://localhost:3000
# Optional. Legacy fallback for Mistral OCR when no private OCR config exists; not the primary setup path.
# Admin Settings OCR config takes precedence when a private config file exists.
MISTRAL_API_KEY=

# PRIVATE_CONFIG_KEYRING — Required for cloud OCR provider credentials.
# Format: keyId:base64url(32-byte-key)[,oldKeyId:oldKey...]
# The first key encrypts; all keys decrypt (supports rotation).
# Generate a key automatically: npm run cli:setup-private-config-keyring -- --env-target .env
# Rotate (prepend new key, keep old keys for decryption): add --rotate
# Without this variable, Tesseract (browser-local) is the only available OCR provider.
PRIVATE_CONFIG_KEYRING=
